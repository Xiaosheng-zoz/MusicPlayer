<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 刻意不用 MAUI：MAUI 的资源系统（resizetizer）会调用 actool，
		     而 CI 镜像上的 Xcode 26.6 调 actool 会失败（xcrun 那次查找调用返回 EINVAL）。
		     探针要回答的是"iOS 能不能读/播 24bit FLAC"，用不用 MAUI 与技术结论无关——
		     TagLib 和 AVFoundation 都在。所以这里用最朴素的 UIKit 应用，
		     没有资源系统，不碰 actool。 -->
		<TargetFramework>net10.0-ios</TargetFramework>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<ApplicationTitle>IosProbe</ApplicationTitle>
		<ApplicationId>com.xszoz.iosprobe</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- 和 PC 端同一个元数据读取库 -->
		<PackageReference Include="TagLibSharp" Version="2.3.0" />

		<!-- 24bit/96kHz 的测试样本，打进应用包根目录 -->
		<BundleResource Include="Resources\Raw\sample-24bit96k.flac">
			<LogicalName>sample-24bit96k.flac</LogicalName>
		</BundleResource>
	</ItemGroup>

</Project>
