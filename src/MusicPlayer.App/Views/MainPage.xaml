<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MusicPlayer.App.ViewModels"
             x:Class="MusicPlayer.App.Views.MainPage"
             x:Name="PageRoot"
             Title="音乐播放器"
             BackgroundColor="#FFFFFF">

  <Grid ColumnDefinitions="132,*" x:Name="RootGrid">

    <!-- 只负责出声，不参与视觉；Opacity=0 加 InputTransparent 保证看不见也点不到 -->
    <toolkit:MediaElement x:Name="Media"
                          Grid.ColumnSpan="2"
                          Opacity="0"
                          InputTransparent="True"
                          ShouldAutoPlay="False"
                          ShouldShowPlaybackControls="False" />

    <!-- 侧栏：音乐 / 文件夹 / 设置可用，歌单按最终形态占位但禁用 -->
    <VerticalStackLayout Grid.Column="0" x:Name="Sidebar"
                         BackgroundColor="#F5F6F8" Padding="8,10" Spacing="2">

      <Label x:Name="SideMusic" Text="♪   音乐" Padding="9,7" FontSize="11.5" TextColor="#5B6270">
        <Label.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding ShowMusicCommand}" />
        </Label.GestureRecognizers>
        <Label.Triggers>
          <DataTrigger TargetType="Label" Binding="{Binding IsMusicSelected}" Value="True">
            <Setter Property="BackgroundColor" Value="#E7EEFC" />
            <Setter Property="TextColor" Value="#2F6FED" />
          </DataTrigger>
        </Label.Triggers>
      </Label>

      <Label x:Name="SideFolders" Text="▤   文件夹" Padding="9,7" FontSize="11.5" TextColor="#5B6270">
        <Label.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding ShowFoldersCommand}" />
        </Label.GestureRecognizers>
        <Label.Triggers>
          <DataTrigger TargetType="Label" Binding="{Binding IsFoldersSelected}" Value="True">
            <Setter Property="BackgroundColor" Value="#E7EEFC" />
            <Setter Property="TextColor" Value="#2F6FED" />
          </DataTrigger>
        </Label.Triggers>
      </Label>

      <Label x:Name="SidePlaylist" Text="≡   歌单" Padding="9,7" FontSize="11.5" TextColor="#5B6270" Opacity="0.45" />

      <Label x:Name="SideSettings" Text="⚙   设置" Padding="9,7" FontSize="11.5" TextColor="#5B6270" VerticalOptions="End">
        <Label.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding ShowSettingsCommand}" />
        </Label.GestureRecognizers>
        <Label.Triggers>
          <DataTrigger TargetType="Label" Binding="{Binding IsSettingsSelected}" Value="True">
            <Setter Property="BackgroundColor" Value="#E7EEFC" />
            <Setter Property="TextColor" Value="#2F6FED" />
          </DataTrigger>
        </Label.Triggers>
      </Label>
    </VerticalStackLayout>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

      <!-- ===== 音乐：搜索栏 + 歌曲列表 ===== -->
      <Grid Grid.Row="0" Grid.RowSpan="2" RowDefinitions="Auto,*" IsVisible="{Binding IsMusicSelected}">

        <VerticalStackLayout Grid.Row="0" Padding="16,12,16,8" Spacing="6">
          <Entry Text="{Binding SearchText}" Placeholder="搜索歌名或歌手"
                 FontSize="12.5" TextColor="#1B1D22" PlaceholderColor="#9AA1AF"
                 ClearButtonVisibility="WhileEditing" HeightRequest="36" />
          <Label Text="{Binding MusicStatusText}" FontSize="10.5" TextColor="#8B93A2" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding VisibleTracks}" SelectionMode="None" Margin="8,0">
          <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:TrackItem">
              <Grid Padding="6,0,10,0" HeightRequest="50" ColumnDefinitions="30,34,*,48" ColumnSpacing="9"
                    BackgroundColor="{Binding RowColor}">
                <Label Grid.Column="0" Text="{Binding Number}" FontSize="10.5" TextColor="#9AA1AF"
                       VerticalOptions="Center" HorizontalTextAlignment="End" />

                <Border Grid.Column="1" WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                        BackgroundColor="#9DBCF7">
                  <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                  </Border.StrokeShape>
                  <Image Source="{Binding Cover}" Aspect="AspectFill" />
                </Border>

                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                  <Label Text="{Binding Title}" FontSize="12" FontAttributes="Bold" TextColor="#1B1D22" LineBreakMode="TailTruncation" />
                  <Label Text="{Binding Subtitle}" FontSize="10.5" TextColor="#8B93A2" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <Label Grid.Column="3" Text="{Binding Duration}" FontSize="11" TextColor="#8B93A2"
                       VerticalOptions="Center" HorizontalTextAlignment="End" />

                <Grid.GestureRecognizers>
                  <TapGestureRecognizer
                      Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.PlayTrackCommand}"
                      CommandParameter="{Binding .}" />
                  <PointerGestureRecognizer PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited" />
                </Grid.GestureRecognizers>
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsEmpty}"
                             VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
          <Label Text="♫" FontSize="30" HorizontalOptions="Center" Opacity="0.3" />
          <Label Text="{Binding MusicEmptyTitle}" FontSize="13.5" FontAttributes="Bold" HorizontalOptions="Center" />
          <Label Text="{Binding MusicEmptyDetail}" FontSize="11.5" TextColor="#8B93A2" HorizontalOptions="Center" />
          <Button Text="去选文件夹" Command="{Binding ShowFoldersCommand}" BackgroundColor="#2F6FED"
                  TextColor="#FFFFFF" FontSize="12" CornerRadius="8" Padding="18,9" HorizontalOptions="Center" />
        </VerticalStackLayout>
      </Grid>

      <!-- ===== 文件夹：只管扫描，只报数量 ===== -->
      <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsFoldersSelected}"
                           Padding="20,16" Spacing="14">
        <Label Text="文件夹" FontSize="16" FontAttributes="Bold" TextColor="#1B1D22" />

        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <Entry Grid.Column="0" Text="{Binding FolderPath}" Completed="OnFolderPathCompleted"
                 Placeholder="音乐文件夹路径，例如 E:\LocalMusic"
                 FontSize="11.5" TextColor="#1B1D22" PlaceholderColor="#9AA1AF"
                 ClearButtonVisibility="WhileEditing" HeightRequest="36" />
          <Button Grid.Column="1" Text="打开" Command="{Binding OpenFolderCommand}" HeightRequest="36"
                  BackgroundColor="#2F6FED" TextColor="#FFFFFF" FontSize="12" CornerRadius="8" Padding="14,6" />
          <Button Grid.Column="2" Text="浏览…" Clicked="OnChooseFolderClicked" HeightRequest="36"
                  BackgroundColor="Transparent" TextColor="#2F6FED" BorderColor="#2F6FED" BorderWidth="1"
                  FontSize="12" CornerRadius="8" Padding="14,6" />
        </Grid>

        <Border BackgroundColor="#F7F9FC" StrokeThickness="0" Padding="16,14">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="8" />
          </Border.StrokeShape>
          <VerticalStackLayout Spacing="4">
            <Label Text="{Binding FolderStatusTitle}" FontSize="22" FontAttributes="Bold" TextColor="#1B1D22" />
            <Label Text="{Binding FolderStatusDetail}" FontSize="10.5" TextColor="#8B93A2" LineBreakMode="TailTruncation" />
          </VerticalStackLayout>
        </Border>

        <Label Text="扫描结果只在这里显示数量，歌曲列表在左边的「音乐」里。"
               FontSize="10" TextColor="#9AA1AF" />
      </VerticalStackLayout>

      <!-- ===== 设置 ===== -->
      <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsSettingsSelected}"
                           Padding="20,16" Spacing="16">
        <Label Text="设置" FontSize="16" FontAttributes="Bold" TextColor="#1B1D22" />

        <Border BackgroundColor="#F7F9FC" StrokeThickness="0" Padding="16,14">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="8" />
          </Border.StrokeShape>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Grid.Column="0" Spacing="3">
              <Label Text="记住上次打开的文件夹" FontSize="12.5" TextColor="#1B1D22" />
              <Label Text="{Binding RememberLastFolderHint}" FontSize="10.5" TextColor="#8B93A2" />
            </VerticalStackLayout>
            <Switch Grid.Column="1" IsToggled="{Binding RememberLastFolder}"
                    OnColor="#2F6FED" VerticalOptions="Center" />
          </Grid>
        </Border>

        <Label Text="{Binding SettingsFilePath}" FontSize="10" TextColor="#9AA1AF" />
      </VerticalStackLayout>

      <!-- ===== 底部播放条（各视图下都在） ===== -->
      <Grid Grid.Row="2" x:Name="TransportBar" HeightRequest="64" BackgroundColor="#FCFCFD"
            Padding="14,0" ColumnDefinitions="190,Auto,*,Auto,96" ColumnSpacing="14">

        <HorizontalStackLayout Grid.Column="0" Spacing="9" VerticalOptions="Center">
          <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" BackgroundColor="#2F6FED">
            <Border.StrokeShape><RoundRectangle CornerRadius="7" /></Border.StrokeShape>
            <Image Source="{Binding NowCover}" Aspect="AspectFill" />
          </Border>
          <VerticalStackLayout VerticalOptions="Center" Spacing="0">
            <Label Text="{Binding NowTitle}" FontSize="11.5" FontAttributes="Bold" TextColor="#1B1D22" LineBreakMode="TailTruncation" />
            <Label Text="{Binding NowSubtitle}" FontSize="10" TextColor="#8B93A2" LineBreakMode="TailTruncation" />
          </VerticalStackLayout>
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Column="1" Spacing="13" VerticalOptions="Center">
          <Button Text="⏮" Clicked="OnPreviousClicked" BackgroundColor="Transparent" TextColor="#5B6270" FontSize="14" Padding="0" WidthRequest="28" />
          <Button x:Name="PlayPauseButton" Text="▶" Clicked="OnPlayPauseClicked"
                  BackgroundColor="#2F6FED" TextColor="#FFFFFF" FontSize="12"
                  WidthRequest="34" HeightRequest="34" CornerRadius="17" Padding="0" />
          <Button Text="⏭" Clicked="OnNextClicked" BackgroundColor="Transparent" TextColor="#5B6270" FontSize="14" Padding="0" WidthRequest="28" />
        </HorizontalStackLayout>

        <Grid Grid.Column="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9" VerticalOptions="Center">
          <Label x:Name="PositionLabel" Grid.Column="0" Text="0:00" FontSize="10" TextColor="#8B93A2" VerticalOptions="Center" />
          <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1"
                  MaximumTrackColor="#E2E6EE" MinimumTrackColor="#2F6FED" ThumbColor="#2F6FED"
                  DragStarted="OnProgressDragStarted" DragCompleted="OnProgressDragCompleted" />
          <Label x:Name="DurationLabel" Grid.Column="2" Text="--:--" FontSize="10" TextColor="#8B93A2" VerticalOptions="Center" />
        </Grid>

        <Button Grid.Column="3" Text="{Binding PlayModeGlyph}" Clicked="OnPlayModeClicked"
                ToolTipProperties.Text="{Binding PlayModeTooltip}"
                BackgroundColor="Transparent" TextColor="#5B6270" BorderWidth="0"
                FontSize="13" CornerRadius="6" Padding="6,2" HeightRequest="30" MinimumWidthRequest="42"
                VerticalOptions="Center" />

        <HorizontalStackLayout Grid.Column="4" x:Name="VolumeGroup" Spacing="7" VerticalOptions="Center">
          <Label Text="🔊" FontSize="11" TextColor="#8B93A2" VerticalOptions="Center" />
          <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.8"
                  MaximumTrackColor="#E2E6EE" MinimumTrackColor="#B9C3D4" ThumbColor="#B9C3D4"
                  WidthRequest="70" ValueChanged="OnVolumeChanged" />
        </HorizontalStackLayout>
      </Grid>

    </Grid>
  </Grid>
</ContentPage>
